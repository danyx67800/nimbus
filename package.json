{
  "name": "nimbus",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Self-hosted files, chat, calls and AirDrop-style quick share",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/build-web.mjs && tsx watch src/index.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "node scripts/build-web.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "biome check src web test scripts",
    "test": "tsx --test test/*.test.ts",
    "package:umbrel": "node scripts/package-umbrel.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "fastify": "^5.12.8",
    "hash-wasm": "^4.13.0",
    "web-push": "^4.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
