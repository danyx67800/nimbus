# Copy to .env and adjust. Never commit .env.
NIMBUS_PORT=3456

# Set to true only when Nimbus is behind a reverse proxy that overwrites
# X-Forwarded-Proto and X-Forwarded-For.
TRUST_PROXY=false
REQUIRE_HTTPS=false
SECURE_COOKIES=auto

# Required only for the optional `calls` profile (coturn).
# Generate with: openssl rand -hex 32
TURN_SECRET=
TURN_HOST=
TURN_PORT=3478
# IP announced for the relay when Docker/NAT hides the real address
# (LAN IP, public IP, or the Tailscale 100.x.y.z address).
TURN_EXTERNAL_IP=
TURN_REALM=nimbus

# Optional ClamAV profile.
CLAMAV_HOST=
CLAMAV_PORT=3310
